# ============================================================
# MediAssist AI - Environment Configuration
# Copy this to backend/.env for local development, and set the
# same variables (without secrets in source control) on Railway.
# ============================================================

# --- Database ---------------------------------------------------
# Production (Railway Postgres). Railway provides this automatically
# when a PostgreSQL plugin is attached to the service.
# DATABASE_URL=postgresql://user:password@host:port/mediassist
#
# Local fallback (SQLite) - used automatically if DATABASE_URL is unset.
# DATABASE_URL=sqlite:///./mediassist.db

# --- Security ----------------------------------------------------
# REQUIRED. The app refuses to start without a strong SECRET_KEY.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --------------------------------------------------------
# Comma-separated origins allowed to call the API.
# Production:
# CORS_ORIGINS=https://mediassist.dpdns.org,https://mediassist-ai.vercel.app
# Local:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- HttpOnly auth cookies ---------------------------------------
# COOKIE_SECURE=true  (set to true in production over HTTPS)
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=      (optional, e.g. .example.com for shared cookies)

# Frontend origin used in password-reset emails.
# FRONTEND_URL=http://localhost:3000

# --- Email (optional, for password reset emails) -----------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=MediAssist AI <no-reply@example.com>
# SMTP_TLS=true

# --- Bootstrap admin (creates the first admin on first startup) --
# BOOTSTRAP_ADMIN_EMAIL=admin@mediassist.local
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password-here

# --- OAuth (Google / GitHub) ---------------------------------
# Both client id AND secret are required for the provider's sign-in button
# to work. Leave empty to disable that provider's OAuth button flow.
# Goauh must be registered with the backend callback URL as an
# authorized redirect URI: <PUBLIC_API_URL>/api/auth/oauth/google/callback
# /.../oauth/github/callback for GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public-facing base URL of the API. Used to build OAuth callback URLs.
# Local: http://localhost:8000   Vercel/Railway: https://your-app-domain
# PUBLIC_API_URL=http://localhost:8000

# --- Rate limiting (per IP) --------------------------------------
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_LOGIN_WINDOW=300
# RATE_LIMIT_REGISTER=3
# RATE_LIMIT_REGISTER_WINDOW=3600
# RATE_LIMIT_REFRESH=30
# RATE_LIMIT_REFRESH_WINDOW=300
# RATE_LIMIT_FORGOT=3
# RATE_LIMIT_FORGOT_WINDOW=3600
# RATE_LIMIT_PREDICT=20
# RATE_LIMIT_PREDICT_WINDOW=60
# RATE_LIMIT_NEARBY=10
# RATE_LIMIT_NEARBY_WINDOW=60
# ACCOUNT_LOCKOUT_THRESHOLD=5
# ACCOUNT_LOCKOUT_MINUTES=15

# --- Password policy ---------------------------------------------
# MIN_PASSWORD_LENGTH=12
# MAX_PASSWORD_LENGTH=128
