# ============================================================
# MediAssist AI - Environment Configuration
# Copy this to backend/.env for local development, and set the
# same variables (without secrets in source control) on Railway.
# ============================================================

# --- Database ---------------------------------------------------
# Production (Railway Postgres). Railway provides this automatically
# when a PostgreSQL plugin is attached to the service.
# DATABASE_URL=postgresql://user:password@host:port/mediassist
#
# Local fallback (SQLite) - used automatically if DATABASE_URL is unset.
# DATABASE_URL=sqlite:///./mediassist.db

# --- Security ----------------------------------------------------
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS --------------------------------------------------------
# Comma-separated origins allowed to call the API.
# Production:
# CORS_ORIGINS=https://mediassist.dpdns.org,https://mediassist-ai.vercel.app
# Local:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Email (optional, for password reset emails) -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
