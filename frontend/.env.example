# Next.js public env vars (inlined at build time - prefix MUST be NEXT_PUBLIC_)

# Local development: points the frontend at the local FastAPI server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (frontend + backend share one Vercel domain): leave UNSET or set
# to "" so the app calls the API same-origin and /api/* paths are routed to the
# backend service by vercel.json. Do NOT point it at localhost in production.
