# Next.js public env vars (inlined at build time - prefix MUST be NEXT_PUBLIC_)

# Local development: points the frontend at the local FastAPI server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local only: keep NEXT_PUBLIC_API_URL=http://localhost:8000 for the
# Browser -> Next.js :3000 -> FastAPI :8000 -> Ollama :11434 architecture.
